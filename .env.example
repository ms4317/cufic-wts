# 이 파일을 .env로 복사하고 값을 채운다. .env는 커밋되지 않는다.
#
# 값은 Supabase 대시보드에서:
#   Project Settings → API → Project URL / Project API keys(anon public)

# 브라우저에 노출되는 값이다. 원래 공개 전제이며 비밀이 아니다.
# 실제 보안은 RLS 정책과 RPC 내부 검증이 담당한다.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# 관리자 화면(/admin) 비밀번호. 코드에 하드코딩하지 않는다.
VITE_ADMIN_PASSWORD=change-me

# ── 아래는 CLI 전용. 브라우저 번들에 들어가지 않는다(VITE_ 접두사 없음).
# supabase link / db push 에 필요하며 진짜 비밀이다.
#   access token: 대시보드 → Account → Access Tokens
#   db password : 프로젝트 생성 시 정한 비밀번호
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_DB_PASSWORD=
